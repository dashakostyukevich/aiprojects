# Git bookkeeping not tracked in this container repo.
# Note: ignoring .gitattributes means the `* text=auto` normalization rule stays
# local to this machine. Fine for a personal container, wrong for a shared clone.
.gitattributes

# Tracked on purpose: AGENTS.md, OpenCode Here.command, and this file.
# Everything under projects/ is tracked by this repo too — it is the only repo in the workspace.
# Each project keeps its own .gitignore for node_modules, dist, and similar.
